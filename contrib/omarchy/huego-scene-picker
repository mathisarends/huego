#!/usr/bin/env bash
# Pick a Hue scene with Walker and activate it. Install to ~/.local/bin.
# Pass a room or zone to only offer its scenes: huego-scene-picker Office
set -euo pipefail

args=(scene list --names)
if [[ $# -gt 0 ]]; then
  args+=(--group "$1")
fi

scene=$(huego "${args[@]}" | walker --dmenu -p "Scene…") || exit 0
[[ -n $scene ]] || exit 0

if ! output=$(huego scene activate "$scene" 2>&1); then
  notify-send "Hue" "$output"
  exit 1
fi
